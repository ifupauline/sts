# SPDX-License-Identifier: Apache-2.0
#
# Convenience wrapper around CMake (the build itself is in CMakeLists.txt)
# and maintenance of the third-party code in vendor/.
#
#   make               build build/bin/sts
#   make test          build and run the test suite
#   make asan          same with AddressSanitizer + UBSan
#   make install       install sts, its manual and examples in PREFIX
#   make uninstall     remove them
#   make fuzz          build the fuzzers (clang), run each for FUZZ_SECS
#   make vendor        refresh vendor/ from the upstream versions below
#   make vendor-check  verify that vendor/ matches those upstream versions
#   make clean         remove the build directories

BUILD_DIR  ?= build
BUILD_TYPE ?= RelWithDebInfo
PREFIX     ?= /usr/local
FUZZ_SECS  ?= 60
JOBS       ?= $(shell nproc 2>/dev/null || echo 4)

# --- third-party versions, change them and run `make vendor` --------------
MBEDTLS_REPO := https://github.com/Mbed-TLS/mbedtls.git
MBEDTLS_REF  := v3.6.7
PAHO_REPO    := https://github.com/eclipse/paho.mqtt.embedded-c.git
PAHO_REF     := 6035ea2d4922bb7558b444fb2a051743f3f1974b

VENDOR_TMP := $(BUILD_DIR)/vendor-upstream

.PHONY: all test asan install uninstall fuzz clean vendor vendor-check \
	vendor-fetch

all:
	cmake -S . -B $(BUILD_DIR) -DCMAKE_BUILD_TYPE=$(BUILD_TYPE)
	cmake --build $(BUILD_DIR) -j $(JOBS)
	@echo "built $(BUILD_DIR)/bin/sts"

test: all
	cd $(BUILD_DIR) && ctest --output-on-failure

asan:
	cmake -S . -B $(BUILD_DIR)-asan -DCMAKE_BUILD_TYPE=Debug -DSTS_SANITIZE=ON
	cmake --build $(BUILD_DIR)-asan -j $(JOBS)
	cd $(BUILD_DIR)-asan && ctest --output-on-failure

# after make, usually as root (sudo make install); DESTDIR is honoured
install:
	@test -x $(BUILD_DIR)/bin/sts || { echo "run make first"; exit 1; }
	cmake --install $(BUILD_DIR) --prefix $(PREFIX)

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/sts
	rm -f $(DESTDIR)$(PREFIX)/share/man/man1/sts.1
	rm -rf $(DESTDIR)$(PREFIX)/share/doc/sts

fuzz:
	CC=clang cmake -S . -B $(BUILD_DIR)-fuzz -DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DSTS_FUZZ=ON -DSTS_BUILD_TESTS=OFF
	cmake --build $(BUILD_DIR)-fuzz -j $(JOBS)
	for f in room transfer config; do \
		mkdir -p $(BUILD_DIR)-fuzz/corpus-$$f && \
		$(BUILD_DIR)-fuzz/fuzz/fuzz_$$f -max_total_time=$(FUZZ_SECS) \
			$(BUILD_DIR)-fuzz/corpus-$$f tests/fuzz/seeds/$$f || exit 1; \
	done

clean:
	rm -rf $(BUILD_DIR) $(BUILD_DIR)-asan $(BUILD_DIR)-fuzz

# --- vendor/ ---------------------------------------------------------------
#
# vendor/ holds unmodified upstream files: the mbedtls libraries (crypto,
# X.509, TLS) and the paho MQTTPacket serializers. Nothing is downloaded by
# a normal build, only by these targets.

vendor-fetch:
	rm -rf $(VENDOR_TMP)
	mkdir -p $(VENDOR_TMP)
	git -c advice.detachedHead=false clone -q --depth 1 \
		--branch $(MBEDTLS_REF) $(MBEDTLS_REPO) $(VENDOR_TMP)/mbedtls
	git init -q $(VENDOR_TMP)/paho
	git -C $(VENDOR_TMP)/paho fetch -q --depth 1 $(PAHO_REPO) $(PAHO_REF)
	git -C $(VENDOR_TMP)/paho -c advice.detachedHead=false checkout -q FETCH_HEAD

# $(call vendor_copy,DESTINATION): lay out the upstream files like vendor/
define vendor_copy
	rm -rf $(1)/mbedtls $(1)/paho-mqtt
	mkdir -p $(1)/mbedtls/library $(1)/paho-mqtt/MQTTPacket/src
	cp $(VENDOR_TMP)/mbedtls/LICENSE $(1)/mbedtls/
	cp -r $(VENDOR_TMP)/mbedtls/include $(1)/mbedtls/
	rm -f $(1)/mbedtls/include/CMakeLists.txt
	cp $(VENDOR_TMP)/mbedtls/library/*.h $(1)/mbedtls/library/
	sed -n '/^set(src_\(crypto\|x509\|tls\)/,/)/p' \
		$(VENDOR_TMP)/mbedtls/library/CMakeLists.txt | \
		grep -o '[A-Za-z0-9_]*\.c' | LC_ALL=C sort > $(1)/mbedtls/sources.txt
	cd $(VENDOR_TMP)/mbedtls/library && \
		cp $$(cat $(CURDIR)/$(1)/mbedtls/sources.txt) $(CURDIR)/$(1)/mbedtls/library/
	cd $(VENDOR_TMP)/paho && \
		cp LICENSE edl-v10 epl-v20 notice.html $(CURDIR)/$(1)/paho-mqtt/ && \
		cp MQTTPacket/src/*.c MQTTPacket/src/*.h \
			$(CURDIR)/$(1)/paho-mqtt/MQTTPacket/src/
	{ echo "# generated by make vendor, do not edit"; \
	  echo "mbedtls   $(MBEDTLS_REPO) $(MBEDTLS_REF) $$(git -C $(VENDOR_TMP)/mbedtls rev-parse HEAD)"; \
	  echo "paho-mqtt $(PAHO_REPO) $$(git -C $(VENDOR_TMP)/paho rev-parse HEAD)"; \
	} > $(1)/VERSIONS
endef

vendor: vendor-fetch
	$(call vendor_copy,vendor)
	rm -rf $(VENDOR_TMP)
	@echo "vendor/ updated:"
	@cat vendor/VERSIONS
	@git status --short vendor | head -20

vendor-check: vendor-fetch
	$(call vendor_copy,$(VENDOR_TMP)/expected)
	@if diff -r vendor $(VENDOR_TMP)/expected >/dev/null; then \
		echo "vendor/ matches upstream:"; cat vendor/VERSIONS; \
		rm -rf $(VENDOR_TMP); \
	else \
		echo "vendor/ differs from upstream:"; \
		diff -rq vendor $(VENDOR_TMP)/expected; \
		rm -rf $(VENDOR_TMP); exit 1; \
	fi
